{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "WSLCockpit",
  "version": "0.1.0",
  "identifier": "io.github.lolofx.wslcockpit",
  "build": {
    "beforeDevCommand": "npm run dev",
    "beforeBuildCommand": "npm run build",
    "devUrl": "http://localhost:1420",
    "frontendDist": "../dist"
  },
  "app": {
    "windows": [{ "title": "WSLCockpit", "width": 960, "height": 640 }],
    "security": { "csp": null }
  },
  "bundle": {
    "active": false,
    "icon": ["icons/icon.ico"]
  }
}
